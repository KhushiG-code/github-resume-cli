# Copy to .env and fill in your token, then `export $(cat .env | xargs)`
# (or use a tool like direnv / python-dotenv in your own shell setup).
#
# Create a token at: https://github.com/settings/tokens
# No scopes are required for public data — a token with zero scopes
# still raises your rate limit and enables the GraphQL pinned-repos query.
GITHUB_TOKEN=ghp_your_token_here
